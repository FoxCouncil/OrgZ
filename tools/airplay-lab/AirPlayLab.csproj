<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hardware lab for the AirPlay 2 stack: pairs and streams to a REAL receiver from
       the command line, using the exact classes the app ships - no copies, no drift.
       NOT part of the app build (OrgZ.csproj excludes tools/**); build/run on its own.
       Run with no arguments for usage. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OrgZ.AirPlayLab</RootNamespace>
    <AssemblyName>AirPlayLab</AssemblyName>
    <!-- The referenced OrgZ app is WinExe; silence the "exe referencing exe" notice. -->
    <NoWarn>$(NoWarn);NETSDK1086</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OrgZ.csproj" />
  </ItemGroup>

</Project>
