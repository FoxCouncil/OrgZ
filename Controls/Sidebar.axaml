<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:vm="using:OrgZ.ViewModels"
             xmlns:models="using:OrgZ.Models"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="450"
             x:Class="OrgZ.Controls.Sidebar"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource OrgZMonoFont}" />
        </Style>
        <Style Selector="ListBoxItem:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="SidebarItemTemplate" x:DataType="models:SidebarItem">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <!-- Left indent for sub-rows (e.g. Subscriptions under Podcasts). The 10px
                     StackPanel spacing is added on top, landing the icon ~16px in. -->
                <Border Width="6" IsVisible="{Binding IsSubItem}" />
                <Border Width="18" Height="18" ClipToBounds="True" VerticalAlignment="Center">
                    <Panel>
                        <Image Source="{Binding IconBitmap}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding HasIconBitmap}" />
                        <i:Icon Value="{Binding Icon}" FontSize="14"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding !HasIconBitmap}" />
                    </Panel>
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="16" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <TreeDataTemplate x:Key="DeviceTreeTemplate" x:DataType="models:SidebarItem" ItemsSource="{Binding Children}">
            <!-- Leading space comes from the container theme's Padding (the chevron used to
                 supply it), so no margin here or the rows drift right of the LIBRARY column. -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0">
                <Border Width="18" Height="18" ClipToBounds="True" VerticalAlignment="Center">
                    <Panel>
                        <Image Source="{Binding IconBitmap}"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="{Binding HasIconBitmap}" />
                        <i:Icon Value="{Binding Icon}" FontSize="14"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding !HasIconBitmap}" />
                    </Panel>
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="16" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </TreeDataTemplate>
        <ControlTheme x:Key="SidebarItemContainerTheme" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
        </ControlTheme>
        <!-- Per-level indent for the device tree, down from Fluent's 16. A device has exactly one
             level of children and they're always shown, so the indent only has to read as "under
             this device", not carry a deep hierarchy. -->
        <x:Double x:Key="TreeViewItemIndent">10</x:Double>

        <TreeDataTemplate x:Key="PlaylistTreeTemplate" x:DataType="models:SidebarItem" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0" Background="Transparent">
                <Border Width="18" Height="18" ClipToBounds="True" VerticalAlignment="Center">
                    <i:Icon Value="{Binding Icon}" FontSize="14"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Name}" FontSize="16" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </TreeDataTemplate>
        <!-- The chevron chrome is hidden for the same reason the device tree hides it: it
             reserves leading space on EVERY row, indenting the whole section relative to
             LIBRARY above. Folders still collapse - clicking the row toggles them. -->
        <ControlTheme x:Key="PlaylistTreeItemTheme" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Padding" Value="16,6,0,6" />
            <Style Selector="^ /template/ Panel#PART_ExpandCollapseChevronContainer">
                <Setter Property="IsVisible" Value="False" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="DeviceTreeItemTheme" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <!-- Devices don't collapse. Their children (Podcasts, Audiobooks, playlists) are the
                 point of the device being listed at all, so IsExpanded is pinned True rather than
                 bound to the model, and the chevron is gone - a control that only ever has one
                 valid state is just a thing to mis-click.
                 With the chevron hidden the leading space it used to supply has to come from
                 somewhere, hence the Padding: it keeps a device icon on the same column as the
                 LIBRARY icons above it instead of drifting left. -->
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="Padding" Value="16,6,0,6" />
            <Style Selector="^ /template/ Panel#PART_ExpandCollapseChevronContainer">
                <Setter Property="IsVisible" Value="False" />
                <Setter Property="Margin" Value="0" />
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <Border MinWidth="140" MaxWidth="350" CornerRadius="8" ClipToBounds="True"
            Background="{StaticResource OrgZSurfaceDarkBrush}">

        <DockPanel>
            <!-- LIBRARY header -->
            <TextBlock DockPanel.Dock="Top"
                       Text="LIBRARY"
                       FontFamily="{StaticResource OrgZMonoFont}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SystemControlDisabledBaseMediumLowBrush}"
                       Margin="16,12,0,4" />

            <!-- Library items -->
            <ListBox DockPanel.Dock="Top"
                     x:Name="LibraryListBox"
                     ItemsSource="{Binding LibraryItems}"
                     SelectedItem="{Binding SelectedSidebarItem, Mode=OneWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Margin="0,0,0,4"
                     ItemTemplate="{StaticResource SidebarItemTemplate}"
                     ItemContainerTheme="{StaticResource SidebarItemContainerTheme}"
                     SelectionChanged="LibraryListBox_SelectionChanged"
                     ContextRequested="LibraryListBox_ContextRequested" />

            <!-- Separator -->
            <Separator DockPanel.Dock="Top"
                       Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"
                       Height="1"
                       Margin="12,4" />

            <!-- DEVICES header -->
            <TextBlock DockPanel.Dock="Top"
                       Text="DEVICES"
                       FontFamily="{StaticResource OrgZMonoFont}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SystemControlDisabledBaseMediumLowBrush}"
                       Margin="16,8,0,4" />

            <!-- Device tree: each connected device is a parent with Music/Playlists
                 as children. Auto-expanded by the container theme so the nested items
                 are always visible - the chevron still toggles if the user wants. -->
            <TreeView DockPanel.Dock="Top"
                      x:Name="DeviceTreeView"
                      ItemsSource="{Binding DeviceItems}"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      Margin="0,0,0,4"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ItemTemplate="{StaticResource DeviceTreeTemplate}"
                      ItemContainerTheme="{StaticResource DeviceTreeItemTheme}"
                      SelectionChanged="DeviceTreeView_SelectionChanged" />

            <!-- Shares: read-only OrgZ libraries discovered on the LAN over mDNS.
                 They live in the DEVICES section - a share is a place your music
                 comes from, same as an iPod - hidden entirely when none are mounted.
                 A tree, not a list: the remote's playlists hang under the share. -->
            <TreeView DockPanel.Dock="Top"
                      x:Name="ShareTreeView"
                      ItemsSource="{Binding ShareItems}"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      Margin="0,0,0,4"
                      IsVisible="{Binding ShareItems.Count}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ItemTemplate="{StaticResource DeviceTreeTemplate}"
                      ItemContainerTheme="{StaticResource DeviceTreeItemTheme}"
                      SelectionChanged="ShareTreeView_SelectionChanged" />

            <!-- "No devices" placeholder: only when there are no devices AND no shares -->
            <TextBlock DockPanel.Dock="Top"
                       Text="No devices connected"
                       FontFamily="{StaticResource OrgZMonoFont}"
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="{DynamicResource SystemControlDisabledBaseMediumLowBrush}"
                       Margin="34,2,0,4">
                <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!DeviceItems.Count" />
                        <Binding Path="!ShareItems.Count" />
                    </MultiBinding>
                </TextBlock.IsVisible>
            </TextBlock>

            <!-- Separator -->
            <Separator DockPanel.Dock="Top"
                       Background="{DynamicResource SystemControlBackgroundBaseMediumLowBrush}"
                       Height="1"
                       Margin="12,4" />

            <!-- PLAYLISTS header -->
            <TextBlock DockPanel.Dock="Top"
                       Text="PLAYLISTS"
                       FontFamily="{StaticResource OrgZMonoFont}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource SystemControlDisabledBaseMediumLowBrush}"
                       Margin="16,8,0,4" />

            <!-- Playlist tree: Favorites, then virtual folders, then root playlists. The
                 folders exist only in OrgZ - every .m3u8 sits flat in the music root. -->
            <TreeView DockPanel.Dock="Top"
                      x:Name="PlaylistTreeView"
                      ItemsSource="{Binding PlaylistItems}"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ItemTemplate="{StaticResource PlaylistTreeTemplate}"
                      ItemContainerTheme="{StaticResource PlaylistTreeItemTheme}"
                      SelectionChanged="PlaylistTreeView_SelectionChanged"
                      DragDrop.AllowDrop="True" />

            <!-- Fill remaining space. Part of the playlist area: right-click makes new
                 playlists/folders here, and a playlist dragged here goes back to the root. -->
            <Border x:Name="PlaylistEmptyArea" Background="Transparent" />
        </DockPanel>
    </Border>
</UserControl>
