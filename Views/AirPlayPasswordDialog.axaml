<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		x:Class="OrgZ.Views.AirPlayPasswordDialog"
		x:CompileBindings="False"
		Title="AirPlay Password"
		MinWidth="320" MinHeight="150"
		SizeToContent="WidthAndHeight"
		CanResize="True"
		WindowStartupLocation="CenterOwner"
		Classes="orgzDialog">
	<StackPanel Margin="16" Spacing="12">
		<TextBlock x:Name="PromptText" Text="Password:" />
		<TextBox x:Name="PasswordInput" PasswordChar="•" />
		<CheckBox x:Name="RememberInput" Content="Remember this password" IsChecked="True" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
			<Button Content="OK" Width="70" Click="OkButton_Click" IsDefault="True" />
			<Button Content="Cancel" Width="70" Click="CancelButton_Click" IsCancel="True" />
		</StackPanel>
	</StackPanel>
</Window>
